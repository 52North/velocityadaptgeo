### ------------------------------------------------------------------
### List all available OGC API Processes
### ------------------------------------------------------------------
GET http://localhost:5000/processes
Accept: application/json


### ------------------------------------------------------------------
### Describe the Buffer process
### ------------------------------------------------------------------
GET http://localhost:5000/processes/buffer
Accept: application/json


### ------------------------------------------------------------------
### Execute Buffer process with a Point geometry
### ------------------------------------------------------------------
POST http://localhost:5000/processes/buffer/execution
Content-Type: application/json
Accept: application/json

{
  "inputs": {
    "geometry": {
      "type": "Point",
      "coordinates": [7.1, 50.7]
    },
    "distance": 0.01
  }
}


### ------------------------------------------------------------------
### Execute Buffer process with a LineString geometry
### ------------------------------------------------------------------
POST http://localhost:5000/processes/buffer/execution
Content-Type: application/json
Accept: application/json

{
  "inputs": {
    "geometry": {
      "type": "LineString",
      "coordinates": [
        [7.0, 50.7],
        [7.2, 50.8]
      ]
    },
    "distance": 0.02
  }
}


### ------------------------------------------------------------------
### Execute Buffer process with a Polygon geometry
### ------------------------------------------------------------------
POST http://localhost:5000/processes/buffer/execution
Content-Type: application/json
Accept: application/json

{
  "inputs": {
    "geometry": {
      "type": "Polygon",
      "coordinates": [
        [
          [7.0, 50.7],
          [7.2, 50.7],
          [7.2, 50.9],
          [7.0, 50.9],
          [7.0, 50.7]
        ]
      ]
    },
    "distance": 0.05
  }
}
