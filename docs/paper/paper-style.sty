% All formatting of the paper lives here; main.tex and chapters/ hold content only.
% Values below are placeholders until the formatting guidelines (template/) are transferred.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{paper-style}[2026/10/29 Paper formatting]

% --- Language and fonts -------------------------------------------------------
% TODO: language of the paper (english / ngerman) from the guidelines
\RequirePackage[english]{babel}
% TODO: font family and size from the template. Only Computer Modern is installed
% right now. Times/Helvetica (mathptmx, helvet) need `pacman -S texlive-fontsrecommended`;
% system fonts (Calibri -> Carlito, Arial, ...) need LuaLaTeX + fontspec, i.e.
% `pacman -S texlive-luatex`, and LATEX = lualatex in the Makefile.
% TODO: \RequirePackage[T1]{fontenc} once the font is set (needed for umlauts).

% --- Page layout ----------------------------------------------------------------
% TODO: margins from the guidelines
\RequirePackage[a4paper, top=2.5cm, bottom=2.5cm, left=2.5cm, right=2.5cm]{geometry}

% --- Paragraphs and line spacing -----------------------------------------------
% TODO: line spacing and spacing before/after paragraphs (Word "Abstand vor/nach")
\RequirePackage{setspace}
\setstretch{1.0}
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}

% --- Headings -------------------------------------------------------------------
% TODO: heading sizes, numbering style and spacing from the template
\RequirePackage{titlesec}
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{1em}{}
\titlespacing*{\section}{0pt}{12pt}{6pt}
\titlespacing*{\subsection}{0pt}{12pt}{6pt}

% --- Header and footer ----------------------------------------------------------
% TODO: header/footer content from the template
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}

% --- Captions, tables, figures --------------------------------------------------
% TODO: caption font, label style ("Table 1:" vs. "Tab. 1.") and position
\RequirePackage[font=small, labelfont=bf]{caption}
\captionsetup[table]{position=top}
\RequirePackage{csvsimple}
\RequirePackage{graphicx}
\graphicspath{{figures/}}

% Tables: full grid 0.5 pt, 0.1 cm cell padding, 9 pt, shaded bold header row
% (references/format-spec.md, "Tables")
\RequirePackage[table]{xcolor}
\RequirePackage{tabularx}
\setlength{\arrayrulewidth}{0.5pt}
\setlength{\tabcolsep}{0.1cm}
\definecolor{tablehead}{HTML}{DDDDDD}
\newcommand{\tablefont}{\fontsize{9}{10.35}\selectfont}

% Source line below tables and figures: "Source:" + tab at 1 cm, 6 pt before
% TODO: German labels (Quelle / eigene Darstellung) via babel captionsngerman
\newcommand{\sourcename}{Source:}
\newcommand{\ownwork}{own illustration}
% Like a Word tab: a label wider than the 1 cm stop ("Source:") is followed by a space.
\newsavebox{\sourcelabelbox}
\newcommand{\tabsource}[1]{%
  \par\vspace{6pt}\normalsize\noindent
  \sbox{\sourcelabelbox}{\sourcename\ }%
  \ifdim\wd\sourcelabelbox<1cm
    \makebox[1cm][l]{\sourcename}%
  \else
    \usebox{\sourcelabelbox}%
  \fi
  #1\par}
\let\figsource\tabsource

% --- Citations ------------------------------------------------------------------
% Author-year without comma: "(Vila et al. 2014)" (references/writing-rules.md, "Citations")
% Entry layout comes from wichmann.bst; hanging 0.5 cm, 3 pt between entries
\RequirePackage{natbib}
\setcitestyle{authoryear,round,citesep={,},aysep={},notesep={, }}
\bibliographystyle{wichmann}
\setlength{\bibhang}{0.5cm}
\setlength{\bibsep}{3pt}
% TODO: German words (In: / (Hrsg.) / o. J.) via babel captionsngerman
\newcommand{\bibinname}{In:}
\newcommand{\bibedsname}{(Eds.)}
\newcommand{\bibnodatename}{n.d.}

% --- Links (load last) ------------------------------------------------------------
\RequirePackage[hidelinks]{hyperref}

\endinput
