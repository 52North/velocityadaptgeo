# Secrets only. Every other setting lives in docker-compose.yml.
#   cp LangGraph/.env.sample LangGraph/.env

# A key for this service only, with a spend limit set in the Anthropic console.
ANTHROPIC_API_KEY=
# Only if the laya service requires a key (DECISION_MODEL=laya-shadow)
LAYA_API_KEY=
# Set, every /api/* request needs "Authorization: Bearer <token>". Leave empty for the demo
# frontend, which cannot send that header.
LANGGRAPH_API_TOKEN=
