{
    "name": "Debug FastAPI (Uvicorn)",
    "type": "python",
    "request": "launch",
    "module": "uvicorn",
    "args": [
        "src.app:app",
    ],
    "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
    },
    "configurations": [
        {
            "name": "Debug FastAPI (Uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app:app"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        }
    ]
}
