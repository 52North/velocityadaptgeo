# Root docker-compose settings. Copy to .env and edit; every value below is the
# built-in default, so an absent .env changes nothing.
#   cp .env.sample .env

# Postgres/pgvector — these also compose the default DB_DSN below.
POSTGRES_DB=velocityadaptgeo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres-vector
POSTGRES_PORT=5432

# Set to override the DSN wholesale, e.g. to point at a Postgres outside compose.
# DB_DSN=postgresql://postgres:postgres@postgres-vector:5432/velocityadaptgeo

# Embeddings
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=nomic-embed-text
OLLAMA_HOST=0.0.0.0:11434

# Service endpoints (in-network names, not host ports)
PYGEOAPI_URL=http://pygeoapi:80
LOCAL_PYGEOAPI_URL=http://pygeoapi:80/
NOMINATIM_BASE_URL=http://nominatim:8080

MAX_WORKFLOW_ITERATIONS=16
